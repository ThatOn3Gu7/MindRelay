<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Local-first data policy: allowBackup=false + fullBackupContent=false +
      dataExtractionRules disables Android's cloud/device-transfer system backup
      of app data. MindRelay's memory data is device-only; the only supported
      transfer path is the in-app JSON export/import ("Data & Backup"). This
      keeps the product messaging ("local only, no cloud") truthful.
    -->
    <application
        android:name=".MindRelayApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindRelay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|uiMode"
            android:theme="@style/Theme.MindRelay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
